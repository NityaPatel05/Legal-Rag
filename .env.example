# Copy to .env and fill in real values. Never commit .env.

# --- Vector DB: Qdrant ---
# Outside compose: the 127.0.0.1-bound port docker-compose.yml publishes.
# Inside compose the app is pointed at http://qdrant:6333 regardless.
QDRANT_URL=http://localhost:6333
# REQUIRED by docker-compose.yml (`up` fails without it): the same value is
# set as the Qdrant server's QDRANT__SERVICE__API_KEY and passed to the app.
# Generate one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
QDRANT_API_KEY=change-me-to-a-long-random-string
QDRANT_COLLECTION_NAME=legal_clauses

# --- Embeddings ---
# BGE-M3 is self-hosted by default (no key needed if run locally / on your own infra).
# Outside compose: the embedding server's loopback port (8081 on the host).
BGE_M3_ENDPOINT=http://localhost:8081
# Hugging Face commit of BAAI/bge-m3 the embedding server loads. Pinned so a
# model re-upload can't silently change every vector (which would need a full
# re-ingest). Move it on purpose, then re-ingest.
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
# Optional later swap-in (see architecture.md §8)
VOYAGE_API_KEY=your-voyage-api-key

# --- Reranker ---
COHERE_API_KEY=your-cohere-api-key
COHERE_RERANK_MODEL=rerank-v3.5
RERANK_ENABLED=false         # default off (A6); turn on only if the R3 ablation shows a gain
# Optional if using Voyage rerank instead of Cohere
# VOYAGE_RERANK_API_KEY=your-voyage-api-key

# --- Document parsing: Docling ---
# Docling runs locally by default; no key required unless using a hosted variant.
DOCLING_ENDPOINT=http://localhost:5001
MAX_PASSAGE_CHARS=1000       # goes with GENERATION_TOP_K -- change together (R3)
GENERATION_TOP_K=10

# --- LLM provider (generation, extraction, routing, jailbreak classifier) ---
# Groq (free-tier hosted inference). Get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# openai/gpt-oss-120b: strongest currently-free Groq-hosted model, native JSON mode.
# Swap to llama-3.3-70b-versatile if gpt-oss-120b availability/rate limits are an issue.
GROQ_MODEL=openai/gpt-oss-120b
# Self-hosted OpenAI-compatible endpoint for privileged docs (R9); empty = no LLM for them
PRIVILEGED_LLM_BASE_URL=
PRIVILEGED_LLM_MODEL=
PRIVILEGED_LLM_API_KEY=
# Citation validator entailment layer (R6); empty = off
NLI_MODEL=                   # e.g. cross-encoder/nli-deberta-v3-base
NLI_ENTAILMENT_THRESHOLD=0.5

# --- Observability: LangSmith ---
# LANGSMITH_API_KEY enables the app's own trace exporter, which sends only
# hashes and counts (query/observability/langsmith_tracer.py).
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=legal-contract-rag
# Keep these false. Either one set to true makes LangChain/LangGraph
# auto-trace the full CRAG state -- contract text included -- to LangSmith.
# docker-compose.yml forces both to false in the app container anyway.
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false

# --- Eval: CUAD ---
# Downloaded via Hugging Face datasets (theatticusproject/cuad-qa) or from
# https://www.atticusprojectai.org/cuad — no API key required, CC BY 4.0.
CUAD_DATA_DIR=./eval/cuad_preflight/data

# --- Multi-tenancy / auth ---
DEFAULT_TENANT_ID=dev-tenant
# JSON {"key": {"tenant_id": "t", "matters": ["m"]}} (scoped, deny by default)
# or legacy {"key": "tenant_id"} (tenant-wide). Empty = the app won't start
# unless DEV_MODE=true. Required under docker compose.
API_KEYS={}
# true + empty API_KEYS = unauthenticated, loopback clients only (A5). Useless
# against docker compose (host traffic arrives from the bridge IP).
DEV_MODE=false

# --- Guardrails: audit log (CLAUDE.md #8, immutable/exportable) ---
# docker-compose.yml overrides this to /app/audit/audit.jsonl (a mounted volume).
AUDIT_LOG_PATH=./audit/audit.jsonl

# --- Human review queue (H1); must persist across restarts ---
# docker-compose.yml overrides this to /app/reviews/reviews.sqlite3 (a mounted volume).
REVIEW_DB_PATH=./reviews/reviews.sqlite3
