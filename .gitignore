.env
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# CUAD is a 40MB+ external download (see eval/cuad_preflight/README or
# CUAD_DATA_DIR in .env.example) -- fetched locally, not committed.
eval/cuad_preflight/data/
eval/cuad_preflight/reports/

# Immutable audit log output (query/filters/audit_log.py) -- local runtime
# data, not source.
audit/
# Human review queue store (query/review/store.py) -- runtime data.
reviews/
# Any env file except the checked-in template.
.env.*
!.env.example
# SQLite side files (WAL/journal) if a review DB lands outside reviews/.
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
# LLM response cache (ingestion/metadata/llm_client.py) -- runtime data.
llm_cache/
